# 認証情報のキー名のみ記載する。値は絶対にコミットしないこと。
# ローカルでは .env（.gitignore 済み）、CI では GitHub Secrets に同名で設定する。

# --- フェーズ1（MUR SST / ERDDAP 経由）では認証は不要 ---

# フェーズ1で NASA Earthdata 直接取得（podaac-data-downloader）に
# 切り替える場合に使用
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# フェーズ2: Copernicus Marine（クロロフィル）
CMEMS_USERNAME=
CMEMS_PASSWORD=

# フェーズ3: JAXA G-Portal（GCOM-C/SGLI 250m）
GPORTAL_USERNAME=
GPORTAL_PASSWORD=
